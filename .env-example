# Copy to `.env` and fill in real values. NEVER commit `.env` (guidelines §7.4).
# LLM providers (ADR-003: deepseek -> anthropic -> template fallback chain).
# A vendor with no key here is SKIPPED, not retried — leave the line blank
# rather than pasting a placeholder, or the agent will try to authenticate
# with it and spend the turn deadline finding out (docs/CONFIG.md §4).
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Gmail OAuth client file location (kept OUTSIDE version control, see .gitignore `secrets/`)
GOOGLE_OAUTH_CLIENT_FILE=secrets/credentials.json
GOOGLE_OAUTH_TOKEN_FILE=secrets/token.json
