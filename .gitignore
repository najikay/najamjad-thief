# Secrets — never committed (guidelines §7.4; book rules 39-40)
.env
*.pem
*.key
credentials.json
token.json
secrets/

# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/

# Runtime artifacts (archived per match under version control only via matches/)
logs/
*.log
# The live artifacts directory is scratch: `game_id` keys the filenames, so a
# rerun against the same opponent overwrites it. The versioned copy is the one
# `match_day.py archive` moves to `matches/<team>-<stamp>/` (T-2318). Tracking
# both meant every archive showed up as a tree full of deletions — and one of
# those took the repo-rules gate down with it.
workspace/artifacts/
# Half a series, waiting for the sibling process to merge it (rule 1's two
# processes). Runtime state, never a deliverable.
workspace/partials/
# Runtime output, regenerated every run and rewritten by every test that
# publishes an event. It is real evidence *during* a match — the connection
# forensics read it, and it settled the T-2456 argument — but it is evidence we
# keep from the run that produced it, not a file the repository should carry:
# committed, it turns every local test run into a diff.
workspace/events.jsonl
workspace/dead_letters/

# Per-match private material stays out of history
matches/**/secrets*

# Sweep outputs are regenerated by scripts/sweep.py; keep the latest summary
# (the notebook reads it) and leave the raw per-game JSONL untracked.
results/sweep-*.jsonl

# Local agent scratch, never part of the evidence trail.
.claude/
